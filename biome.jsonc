{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "formatter": { "useEditorconfig": true },
    "markdown": { "formatter": { "enabled": false } }, // handled by panache
    "overrides": [
        {
            "includes": ["./.vscode/*.json", "**/*.jsonc"],
            "json": {
                "formatter": { "trailingCommas": "all" },
                "parser": {
                    "allowComments": true,
                    "allowTrailingCommas": true,
                },
            },
        },
        {
            // asv reads its config with a JSON parser that understands `//` comments but not trailing commas.
            "includes": ["./asv.conf.json"],
            "json": { "parser": { "allowComments": true } },
        },
    ],
    "files": {
        "includes": [
            "**",
            // Claude Code skills and settings, not project source.
            "!.claude",
        ],
    },
}
